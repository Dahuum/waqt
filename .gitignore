# macOS
.DS_Store

# Xcode — per-user state (machine-specific, regenerated by Xcode)
xcuserdata/
*.xcuserstate

# Xcode — build output (regenerated on build)
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager local caches (Package.resolved IS committed on purpose)
.swiftpm/
.build/

# Claude Code local, machine-specific settings
.claude/settings.local.json
